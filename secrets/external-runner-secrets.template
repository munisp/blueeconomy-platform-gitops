# Blue Economy external runner secret template
#
# Fill this template through an approved secret manager or protected operator shell.
# Do not commit the completed file. Save the resulting operator file as:
#   deploy/external/.env
# and set its permissions to 600 or 400.
#
# All values are required unless explicitly marked optional.

# Application PostgreSQL target
DATABASE_URL=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
POSTGRES_MIGRATION_APPROVED=no
POSTGRES_MIGRATION_FILE=./deploy/external/migrations/0000_blueeconomy_baseline.sql

# Keycloak PostgreSQL and bootstrap administrator
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8080

# MinIO bootstrap and public URLs
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenBao listener; initialize and unseal OpenBao separately with operator-controlled material
OPENBAO_BIND_ADDRESS=127.0.0.1
OPENBAO_PORT=8200

# Application OIDC
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Application S3-compatible storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
