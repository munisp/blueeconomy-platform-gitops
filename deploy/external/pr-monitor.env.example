# Copy to /etc/blueeconomy/pr-monitor.env and chmod 600.
# Do not commit the populated file. Inject secrets using the approved host secret manager.

# Required: Slack incoming webhook URL. Keep this blank in the repository.
SLACK_WEBHOOK_URL=

# Poll interval in seconds; 300 = five minutes.
WATCH_SECONDS=300

# Durable local state paths for the dedicated service account.
PR_MONITOR_STATE_FILE=/var/lib/blueeconomy/all-prs-ready.sent
PR_MONITOR_MESSAGE_FILE=/var/lib/blueeconomy/pr-ready-message.txt

# The monitor uses the default repository owner munisp.
# Override only through an approved environment deployment if the owner changes.
REPOSITORY_OWNER=munisp

# Optional health-check alerting. Leave both transports blank to log failures only.
# Webhook delivery requires curl and a URL provisioned by the operator secret manager.
HEALTH_ALERT_WEBHOOK_URL=
# Email delivery uses the host-local sendmail-compatible MTA.
HEALTH_ALERT_EMAIL_TO=
HEALTH_ALERT_EMAIL_FROM=blueeconomy-monitor@localhost
HEALTH_ALERT_SUBJECT=Blue Economy approval monitor health failure

# Bounded recovery controls. Recovery is not enabled until its timer is explicitly activated.
RECOVERY_FAILURE_THRESHOLD=3
RECOVERY_MAX_RESTARTS_PER_WINDOW=1
RECOVERY_WINDOW_SECONDS=900
RECOVERY_FAILURE_FILE=/var/lib/blueeconomy/monitor-failure-count
RECOVERY_RESTART_STATE_FILE=/var/lib/blueeconomy/monitor-restart-state
